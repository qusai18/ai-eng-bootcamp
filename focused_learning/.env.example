# Runtime secret. Never bake this into the image.
# docker compose loads C:\Users\azizk\ai-eng-bootcamp\.env (the repo root file).
# On Render, set OPENAI_API_KEY on the focused-learning service when the blueprint prompts for it.
OPENAI_API_KEY=
# Optional admin key with the api.usage.read scope. Question charges then use
# the rate returned by https://api.openai.com/v1/organization/costs.
OPENAI_ADMIN_KEY=
